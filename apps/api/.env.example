# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sprite:sprite@localhost:5432/sprite_generator

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" writes files to UPLOADS_DIR and serves them via /uploads/*
# "s3" requires the S3_* vars below (not yet implemented)
STORAGE_MODE=local
UPLOADS_DIR=./uploads
PUBLIC_URL=http://localhost:3001

# S3 / R2 (only needed when STORAGE_MODE=s3)
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=sprite-generator
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_REGION=us-east-1

# ── Image Worker ──────────────────────────────────────────────────────────────
IMAGE_WORKER_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
