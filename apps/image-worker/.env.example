PORT=8000
# Storage (S3-compatible) - must match API config
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=sprite-generator
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=us-east-1
# Internal API base URL (for reading project/asset data)
API_BASE_URL=http://localhost:3001
API_INTERNAL_SECRET=change-me
