# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" writes to UPLOADS_DIR.
# In local dev: set UPLOADS_DIR to the same absolute path as the API's UPLOADS_DIR
# so both services write to the same directory.
# Example: UPLOADS_DIR=/home/you/sprite-generator/uploads
STORAGE_MODE=local
UPLOADS_DIR=./uploads
PUBLIC_URL=http://localhost:3001

# S3 / R2 (only needed when STORAGE_MODE=s3)
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=sprite-generator
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_REGION=us-east-1

# ── Internal API ──────────────────────────────────────────────────────────────
# In Docker: set to http://api:3001 so the worker can fetch frame images
# In local dev: http://localhost:3001
API_BASE_URL=http://localhost:3001
API_INTERNAL_SECRET=change-me
